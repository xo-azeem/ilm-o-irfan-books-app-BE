{
  "name": "ilm-o-irfan-app-be",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase backend for Ilm o Irfan (PostgreSQL, Auth, Storage, Edge Functions)",
  "scripts": {
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "functions:serve": "npx supabase functions serve",
    "functions:deploy": "npx supabase functions deploy",
    "functions:list": "npx supabase functions list",
    "link": "npx supabase link",
    "types:generate": "node scripts/gen-types.mjs --linked",
    "types:generate:local": "node scripts/gen-types.mjs --local",
    "books:import": "node scripts/import-folder-books.mjs",
    "books:sample": "node scripts/create-sample-books.mjs",
    "smoke:pdf": "node scripts/verify-pdf-gates.mjs && node scripts/verify-premium-required.mjs",
    "smoke:covers": "node scripts/verify-cover-urls.mjs",
    "smoke:failures": "node scripts/smoke-failure-modes.mjs",
    "test:e2e": "bash scripts/e2e-endpoints.sh",
    "test:import": "node --test scripts/import-rules.test.mjs",
    "test:unit": "deno test --allow-env --allow-net=esm.sh,jsr.io,deno.land,registry.npmjs.org tests/",
    "typecheck": "deno check supabase/functions/_shared/*.ts supabase/functions/*/index.ts",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "ci:static": "node scripts/ci-static-check.mjs",
    "ci": "npm run ci:static && npm run typecheck && npm run lint && npm run test:unit && npm run test:import",
    "deploy:hosted": "node scripts/deploy-hosted.mjs",
    "push:configure": "node scripts/configure-push-hosted.mjs",
    "email:domain": "node scripts/configure-email-domain.mjs",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "smoke:rls": "node scripts/rls-smoke.mjs",
    "auth:print": "node scripts/print-hosted-auth-config.mjs",
    "auth:uris": "node scripts/configure-hosted-auth-uris.mjs",
    "auth:google": "node scripts/enable-hosted-google-auth.mjs"
  },
  "devDependencies": {
    "supabase": "^2.26.0"
  },
  "engines": {
    "node": ">=20"
  }
}
