# Copy to `.env` and fill after creating a Supabase project.
# Never commit real secrets (`.env` is gitignored).

# -----------------------------------------------------------------------------
# Supabase API (Settings → API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key (safe for mobile client with RLS)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (Edge Functions / webhooks ONLY — never ship in the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project ref for npm run deploy:hosted (same as URL subdomain)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Optional: CLI token instead of `npx supabase login`
# SUPABASE_ACCESS_TOKEN=

# Optional: DB password for non-interactive link
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# -----------------------------------------------------------------------------
# Database (Settings → Database → Connection string)
# Use this in pgAdmin as host/user/password/port/db
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Direct connection (pgAdmin preferred for schema work)
PGHOST=db.YOUR_PROJECT_REF.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=YOUR_DB_PASSWORD

# -----------------------------------------------------------------------------
# RevenueCat (Dashboard → Project settings → API keys / webhooks)
# -----------------------------------------------------------------------------
REVENUECAT_WEBHOOK_AUTH=Bearer your-shared-secret
REVENUECAT_ENTITLEMENT_ID=premium

# Staging without RC yet: DEPLOY_ALLOW_PLACEHOLDER_RC=1 npm run deploy:hosted
#
# Edge Function secrets (set by `npm run deploy:hosted` ONLY):
#   REVENUECAT_WEBHOOK_AUTH, REVENUECAT_ENTITLEMENT_ID, SIGNED_PDF_EXPIRES_IN
# Never push DATABASE_URL / PG* / service_role via `supabase secrets set --env-file .env`.
# Those belong in local tooling only; the platform injects SUPABASE_* for functions.

# -----------------------------------------------------------------------------
# Signed PDF URL lifetime (seconds)
# -----------------------------------------------------------------------------
SIGNED_PDF_EXPIRES_IN=300

# -----------------------------------------------------------------------------
# Hosted smoke (npm run smoke:hosted)
# -----------------------------------------------------------------------------
# SUPABASE_USER_JWT=
# SUPABASE_ADMIN_JWT=

# -----------------------------------------------------------------------------
# PDF paywall (get-signed-pdf) — no bypass exists
# -----------------------------------------------------------------------------
# There is deliberately no env flag here. The catalogue is subscription-only:
# get-signed-pdf grants a PDF to the admin role, and otherwise only to a caller
# with an active entitlement. is_premium is not consulted — a book flagged free
# is gated exactly like any other. The former ALLOW_PDF_WITHOUT_ENTITLEMENT
# variable is no longer read — setting it does nothing. To let someone read
# without paying, give them an entitlement.

# -----------------------------------------------------------------------------
# Google OAuth (Web client ID first — required for native Android ID tokens)
# Google Cloud → Credentials → OAuth 2.0 Client IDs:
#   1) Web application (client id + secret) → GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   2) Android (package com.ilmoirfanapp + SHA-1) — optional extra id in the comma list
#   3) iOS when ready
# Authorized redirect URI on the Web client:
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback
# Enable on staging: npm run auth:google
# Native RN often needs: GOOGLE_SKIP_NONCE_CHECK=1
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SKIP_NONCE_CHECK=1
# AUTH_APP_REDIRECTS=ilmoirfan://**

# account-deletion-run: shared secret the database sends as x-ops-secret (see docs/setup-guide.md)
ACCOUNT_DELETION_SECRET=

# -----------------------------------------------------------------------------
# Membership emails (cancelled / resumed / ended / unfinished cancellation)
# email-dispatch: shared secret the database sends as x-ops-secret, and the
# Resend sender. Until all three are set, rows wait in public.email_outbox.
# EMAIL_FROM must be on a domain verified in Resend (Resend → Domains).
# -----------------------------------------------------------------------------
EMAIL_DISPATCH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Ilm o Irfan <no-reply@yourdomain.example>
# EMAIL_REPLY_TO=support@yourdomain.example
#
# Auth Send Email Hook (Dashboard → Authentication → Hooks → Send Email).
# Paste the hook secret here and as the Edge secret SEND_EMAIL_HOOK_SECRET.
# Hook URL: https://<PROJECT_REF>.supabase.co/functions/v1/auth-send-email
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
