# Copy to `.env` and fill after creating a Supabase project.
# Never commit real secrets (`.env` is gitignored).

# -----------------------------------------------------------------------------
# Supabase API (Settings → API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key (safe for mobile client with RLS)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (Edge Functions / webhooks ONLY — never ship in the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Database (Settings → Database → Connection string)
# Use this in pgAdmin as host/user/password/port/db
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Direct connection (pgAdmin preferred for schema work)
PGHOST=db.YOUR_PROJECT_REF.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=YOUR_DB_PASSWORD

# -----------------------------------------------------------------------------
# RevenueCat (Dashboard → Project settings → API keys / webhooks)
# -----------------------------------------------------------------------------
REVENUECAT_WEBHOOK_AUTH=Bearer your-shared-secret
REVENUECAT_ENTITLEMENT_ID=premium

# -----------------------------------------------------------------------------
# Signed PDF URL lifetime (seconds)
# -----------------------------------------------------------------------------
SIGNED_PDF_EXPIRES_IN=300

# -----------------------------------------------------------------------------
# PDF paywall bypass (get-signed-pdf)
# -----------------------------------------------------------------------------
# Controls whether ANY signed-in user can open PDFs without an entitlement.
# Also toggled in-app via Admin → Overview (`app_settings.allow_pdf_without_entitlement`).
#
# Safe default below is OFF. For local/dev open-paywall testing only, set:
#   ALLOW_PDF_WITHOUT_ENTITLEMENT=true
#
# Production / staging public builds: must be false (or unset).
# Leaving this true in production is a security incident.
ALLOW_PDF_WITHOUT_ENTITLEMENT=false

# -----------------------------------------------------------------------------
# Google OAuth (optional until you enable the provider)
# Set these in Supabase Dashboard → Authentication → Providers → Google
# (and in Google Cloud Console). Local config.toml reads them when enabled.
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
